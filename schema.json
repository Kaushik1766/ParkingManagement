{
  "Reasons": {
    "vehicle": "keeping it separate, so i can query using numberplate, plus main reason is that updating/adding/removing any vehicle in vehicle array(if i had embedded, every add/remove/update to a vehicle rewrites the entire user profile",
    "floors": "keeping separate because of 2 reasons 1. same as before adding/removing/updating slot status rewrites the whole building (if embedded), 2. querying for available slots becomes easier",
    "buildingName": "keeping pk as building#buildingid instead of name coz name can change later, but id will remain same"
  },
  // reverse lookup for email to uuid
  "EmailUserIdLookup": {
    "PK": "USER",
    "SK": "<email>",
    "UUID": "<uuid>"
  },
  "User": {
    "PK": "USER#<uuid>",
    "SK": "PROFILE",
    "Email": "<email>",
    "Id": "<uuid>",
    "Username": "<full_name>",
    "PasswordHash": "<hashed_password>",
    "OfficeId": "<uuid>",
    "Role": "<Customer|Admin>"
  },
  "Vehicle": {
    "PK": "USER#<uuid>",
    "SK": "VEHICLE#<numberplate>",
    "VehicleId": "<uuid>",
    "Numberplate": "<numberplate>",
    "VehicleType": "<TwoWheeler|FourWheeler>",
    "IsParked": true,
    "AssignedSlot": {
      "BuildingId": "BUILDING#<building_id>",
      "FloorNumber": 1,
      "SlotId": "SLOT#S1"
    }
  },
  "ParkingHistory": {
    "PK": "USER#<uuid>",
    "SK": "PARKING#timestamp",
    "Numberplate": "UP32KK2222",
    "BuildingId": "BUILDING#B1",
    "FloorNumber": 1,
    "SlotId": "SLOT#S1",
    "StartTime": 1763572066,
    "EndTime": 1763572066
  },
  "Building": {
    "PK": "BUILDING",
    "SK": "BUILDING#B1",
    "BuildingId": "B1",
    "BuildingName": "<building_name>",
    "TotalFloors": 3,
    "AvailableSlots": 50
  },
  "Floor": {
    "PK": "BUILDING#B1",
    "SK": "FLOORINFO#1",
    "FloorNumber": 1,
    "TotalSlots": 20,
    "AvailableSlots": 15,
    "OfficeId": "<uuid>"
  },
  "Office": {
    "PK": "OFFICE",
    "SK": "DETAILS#<uuid>",
    "OfficeName": "Watchguard",
    "BuildingId": "BUILDING#B1",
    "FloorNumber": 1,
    "OfficeId": "uuid"
  },
  "Slot": {
    "PK": "BUILDING#B1",
    "SK": "FLOOR#F1#SLOT#1",
    "SlotId": "1",
    "SlotType": "TwoWheeler",
    "IsOccupied": true,
    // this can be null
    "OccupiedBy?": {
      "Username": "Kaushik Saha",
      "Numberplate": "UP32KK2222",
      "Email": "kaushik@a.com"
    }
  },
  "Bill": {
    "PK": "USER#<uuid>",
    "SK": "BILL#2023#10",
    "TotalAmount": 200,
    "BillDate": "2023-11-01",
    "ParkingHistory": [
      {
        "TicketId": "TICKET001",
        "NumberPlate": "UP32KK2222",
        "BuildingId": "B1",
        "BuildingName": "Advant",
        "FloorNumber": 1,
        "SlotNumber": 1,
        "VehicleType": "TwoWheeler",
        "StartTime": 1763572066,
        "EndTime": 1763572066
      }
    ]
  }
}
