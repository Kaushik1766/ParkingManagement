											"console.log(token)\r",
											"\r",
											"if (token) {\r",
											"    try {\r",
											"        let payload = token.split(\".\")[1];\r",
											"\r",
											"        let decoded = JSON.parse(\r",
											"            atob(payload.replace(/-/g, \"+\").replace(/_/g, \"/\"))\r",
											"        );\r",
											"\r",
											"        let userId = decoded.jti;\r",
											"        console.log(userId)\r",
											"\r",
											"        // pm.iterationData.set(\"userId\",userId)\r",
											"        pm.environment.set(\"userId\",userId)\r",
											"\r",
											"\r",
											"    } catch (e) {\r",
											"        console.log(\"Failed to decode JWT:\", e);\r",
											"    }\r",
											"} else {\r",
											"    console.log(\"No userToken found in env variables.\");\r",
